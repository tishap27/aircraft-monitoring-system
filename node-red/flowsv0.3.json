    {
        "id": "ef9bd3a4d207e38c",
        "type": "function",
        "z": "87ea2ad36bd91ca7",
        "name": "Parse MEGA-1 Data",
        "func": "var line = msg.payload.toString().trim();\n\n// Parse flight data line: Pitch: 12.3° | Roll: -3.5° | Yaw: 45.0° | Alt: 87.5cm | Gear: DOWN | Fan: ON\nif (line.includes('Pitch:') && line.includes('Roll:')) {\n    try {\n        var pitchMatch = line.match(/Pitch:\\s*([\\-\\d\\.]+)/); \n        var rollMatch = line.match(/Roll:\\s*([\\-\\d\\.]+)/);\n        var yawMatch = line.match(/Yaw:\\s*([\\-\\d\\.]+)/);\n        var altMatch = line.match(/Alt:\\s*([\\d\\.]+)/);\n        var gearMatch = line.match(/Gear:\\s*(\\w+)/);\n        var fanMatch = line.match(/Fan:\\s*(\\w+)/);\n        \n        var msgs = [];\n        \n        if (pitchMatch) {\n            msgs.push({payload: parseFloat(pitchMatch[1]), topic: 'pitch'});\n        }\n        if (rollMatch) {\n            msgs.push({payload: parseFloat(rollMatch[1]), topic: 'roll'});\n        }\n        if (yawMatch) {\n            msgs.push({payload: parseFloat(yawMatch[1]), topic: 'yaw'});\n        }\n        if (altMatch) {\n            msgs.push({payload: parseFloat(altMatch[1]), topic: 'altitude'});\n        }\n        if (gearMatch) {\n            msgs.push({payload: gearMatch[1], topic: 'gear'});\n        }\n        if (fanMatch) {\n            msgs.push({payload: fanMatch[1], topic: 'fan'});\n        }\n        \n        return [msgs];\n    } catch(e) {\n        node.warn('Parse error: ' + e);\n    }\n}\n\nreturn null;",
        "outputs": 1,
        "x": 360,
        "y": 180,
        "wires": [
            [
                "d10d1cefe5fd3b9c"
            ]
        ]
    },
    {
        "id": "e720c0ccb3f47ebb",
        "type": "function",
        "z": "87ea2ad36bd91ca7",
        "name": "Parse MEGA-2 JSON",
        "func": "var line = msg.payload.toString().trim();\n\n// Parse JSON line from MEGA-2\nif (line.includes('JSON:')) {\n    try {\n        var jsonStart = line.indexOf('{');\n        var jsonStr = line.substring(jsonStart);\n        var data = JSON.parse(jsonStr);\n        \n        return [\n            {payload: data.temp, topic: 'temperature'},\n            {payload: data.humidity, topic: 'humidity'},\n            {payload: data.motion, topic: 'motion'},\n            {payload: data.night, topic: 'night'},\n            {payload: data.gate, topic: 'gate'},\n            {payload: data.stepper, topic: 'stepper'}\n        ];\n    } catch(e) {\n        node.warn('JSON parse error: ' + e);\n    }\n}\n\nreturn null;",
        "outputs": 6,
        "x": 360,
        "y": 240,
        "wires": [
