    {
        "id": "46fb9e7c741d2273",
        "type": "ui_template",
        "z": "87ea2ad36bd91ca7",
        "group": "flight_data",
        "name": "Enhanced Dark Theme CSS",
        "order": 99,
        "width": 0,
        "height": 0,
        "format": "<style>\n    /* ========== DARK THEME BASE ========== */\n    body {\n        background: #0a0e27 !important;\n    }\n    \n    .nr-dashboard-theme md-content {\n        background: #0a0e27 !important;\n    }\n    \n    md-card {\n        background: linear-gradient(145deg, #1a1f3a, #0f1228) !important;\n        border: 1px solid #2d3561 !important;\n        box-shadow: 0 8px 32px rgba(0, 0, 0, 0.4) !important;\n        border-radius: 12px !important;\n    }\n    \n    md-card-title {\n        background: linear-gradient(135deg, #1a1f3a, #252b52) !important;\n        color: #00d4ff !important;\n        font-weight: bold !important;\n        border-bottom: 2px solid #00d4ff !important;\n        font-size: 1.1em !important;\n    }\n    \n    md-card-content {\n        background: #0f1228 !important;\n        color: #e0e0e0 !important;\n    }\n    \n    /* ========== ALTITUDE DISPLAY ========== */\n    .altitude-display {\n        font-size: 2.8em !important;\n        font-weight: bold !important;\n        color: #00ff41 !important;\n        text-shadow: 0 0 25px #00ff41, 0 0 50px #00ff41 !important;\n        background: linear-gradient(145deg, #1a3a1f, #0f2813) !important;\n        padding: 25px !important;\n        border-radius: 15px !important;\n        border: 3px solid #00ff41 !important;\n        animation: pulse 2s ease-in-out infinite !important;\n    }\n    \n    @keyframes pulse {\n        0%, 100% { box-shadow: 0 0 20px #00ff41; }\n        50% { box-shadow: 0 0 40px #00ff41, 0 0 60px #00ff41; }\n    }\n    \n    /* ========== STATUS TEXT ========== */\n    .status-text {\n        font-size: 2em !important;\n        font-weight: bold !important;\n        color: #00d4ff !important;\n        text-shadow: 0 0 15px #00d4ff !important;\n        background: linear-gradient(145deg, #1a2a3a, #0f1828) !important;\n        padding: 18px !important;\n        border-radius: 10px !important;\n        border: 2px solid #2d3561 !important;\n        transition: all 0.3s ease !important;\n    }\n    \n    .status-text:hover {\n        border-color: #00d4ff !important;\n        box-shadow: 0 0 20px rgba(0, 212, 255, 0.3) !important;\n    }\n    \n    /* ========== GAUGE STYLING ========== */\n    .dark-gauge text {\n        fill: #e0e0e0 !important;\n        font-weight: bold !important;\n        font-size: 1.1em !important;\n    }\n    \n    .dark-gauge .pointer {\n        stroke: #00ff41 !important;\n        stroke-width: 3px !important;\n    }\n    \n    /* ========== CHART STYLING ========== */\n    .dark-chart {\n        background: #0f1228 !important;\n    }\n    \n    .dark-chart svg {\n        background: #0f1228 !important;\n    }\n    \n    .dark-chart .ct-line {\n        stroke-width: 3px !important;\n    }\n    \n    .dark-chart .ct-grid {\n        stroke: #2d3561 !important;\n    }\n    \n    /* ========== TOOLBAR ========== */\n    md-toolbar {\n        background: linear-gradient(145deg, #1a1f3a, #0f1228) !important;\n        border-bottom: 3px solid #00d4ff !important;\n    }\n    \n    md-toolbar h1 {\n        color: #00d4ff !important;\n        text-shadow: 0 0 20px #00d4ff !important;\n        font-size: 1.8em !important;\n    }\n    \n    /* ========== LABELS ========== */\n    label {\n        color: #00d4ff !important;\n        font-weight: bold !important;\n        font-size: 1.05em !important;\n    }\n    \n    /* ========== SCROLLBAR ========== */\n    ::-webkit-scrollbar {\n        width: 14px;\n        background: #0a0e27;\n    }\n    \n    ::-webkit-scrollbar-thumb {\n        background: linear-gradient(180deg, #2d3561, #1a1f3a);\n        border-radius: 7px;\n        border: 2px solid #0a0e27;\n    }\n    \n    ::-webkit-scrollbar-thumb:hover {\n        background: #00d4ff;\n        box-shadow: 0 0 10px #00d4ff;\n    }\n    \n    /* ========== GRID LINES ========== */\n    md-content {\n        background: #0a0e27 !important;\n    }\n    \n    /* ========== GROUP HEADERS ========== */\n    .nr-dashboard-theme .md-headline {\n        color: #00d4ff !important;\n        text-shadow: 0 0 10px rgba(0, 212, 255, 0.5) !important;\n    }\n</style>",
