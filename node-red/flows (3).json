    {
        "id": "4d2aeb1670cc4a20",
        "type": "function",
        "z": "c871312bbef0b7f6",
        "name": "Parse MEGA-1 (flight data)",
        "func": "var line = msg.payload.toString().trim();\nvar outputs = [];\nfor (var i=0;i<11;i++) outputs.push(null);\ntry {\n    if (line.indexOf('Pitch:') !== -1 && line.indexOf('Roll:') !== -1) {\n        var mPitch = line.match(/Pitch:\\s*([\\-\\d\\.]+)/);\n        var mRoll  = line.match(/Roll:\\s*([\\-\\d\\.]+)/);\n        var mYaw   = line.match(/Yaw:\\s*([\\-\\d\\.]+)/);\n        var mAlt   = line.match(/Alt:\\s*([\\d\\.]+)/);\n        var mGear  = line.match(/Gear:\\s*(\\w+)/);\n        var mFan   = line.match(/Fan:\\s*(\\w+)/);\n        if (mPitch) outputs[0] = { payload: parseFloat(mPitch[1]), topic: 'pitch' };\n        if (mRoll)  outputs[1] = { payload: parseFloat(mRoll[1]), topic: 'roll' };\n        if (mYaw)   outputs[2] = { payload: parseFloat(mYaw[1]), topic: 'yaw' };\n        if (mAlt)   outputs[3] = { payload: parseFloat(mAlt[1]), topic: 'altitude' };\n        if (mGear)  outputs[4] = { payload: mGear[1], topic: 'gear' };\n        if (mFan)   outputs[5] = { payload: mFan[1], topic: 'fan' };\n        return outputs;\n    }\n    if (line.indexOf('Ultrasonic:') !== -1 || line.indexOf('LANDED') !== -1) {\n        var m = line.match(/(Alt:|Ultrasonic:).*?(\\d+\\.?\\d*)/);\n        if (m) return [{payload: parseFloat(m[2]), topic: 'altitude' }];\n    }\n} catch(e) { node.warn('MEGA-1 parse error: '+e); }\nreturn null;\n",
        "outputs": 11,
        "x": 400,
        "y": 140,
        "wires": [
            [
                "da41ab15043376f1"
            ],
            [
                "a8d089cd3549651f"
            ],
            [
                "9bbd420ae535b0d3"
            ],
            [
                "a12a142b0981a43b"
            ],
            [
                "93d4e986ea9abf62"
            ],
            [
                "a5c215979080f654"
            ],
            [],
            [],
            [],
            [],
            []
        ]
    },
    {
        "id": "7b78d011cc513211",
        "type": "function",
        "z": "c871312bbef0b7f6",
        "name": "Parse MEGA-2 JSON & logs",
        "func": "var line = msg.payload.toString().trim();\ntry {\n    if (line.indexOf('JSON:') !== -1) {\n        var jsonStart = line.indexOf('{');\n        var jsonStr = line.substring(jsonStart);\n        var data = JSON.parse(jsonStr);\n        var out = [];\n        out.push({payload: data.temp, topic: 'temperature'});\n        out.push({payload: data.humidity, topic: 'humidity'});\n        out.push({payload: data.motion, topic: 'motion'});\n        out.push({payload: data.night, topic: 'night'});\n        out.push({payload: data.gate, topic: 'gate'});\n        out.push({payload: data.stepper, topic: 'stepper'});\n        out.push({payload: data.detections, topic: 'detections'});\n        out.push({payload: data.plane_conflicts, topic: 'plane_conflicts'});\n        out.push({payload: data.plane_detected, topic: 'plane_detected'});\n        out.push({payload: data.fan, topic: 'fan'});\n        out.push({payload: data.preferred, topic: 'preferred'});\n        return out;\n    }\n    if (line.indexOf('PLANE CONFLICT') !== -1 || line.indexOf('PLANE CONFLICT!!!!') !== -1) {\n        return [{payload:true, topic:'plane_conflict'}];\n    }\n    if (line.indexOf('RFID') !== -1 && line.indexOf('TAG') !== -1) {\n        var uidMatch = line.match(/UID:\\s*([0-9A-Fa-f:\\s]+)/);\n        if (uidMatch) return [{payload: uidMatch[1].trim(), topic: 'rfid_uid'}];\n    }\n} catch(e) { node.warn('MEGA-2 parse error: '+e); }\nreturn null;\n",
        "outputs": 11,
        "x": 420,
        "y": 360,
        "wires": [
